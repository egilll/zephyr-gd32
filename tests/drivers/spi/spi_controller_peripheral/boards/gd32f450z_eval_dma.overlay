&i2s1 {
	status = "disabled";
};

&sdio {
	status = "disabled";
};

&spi3 {
	dmas = <&dma1 0 4 0 0>, <&dma1 1 4 0 0>;
	dma-names = "rx", "tx";
};

&spi4 {
	dmas = <&dma1 5 7 0 0>, <&dma1 6 7 0 0>;
	dma-names = "rx", "tx";
};
