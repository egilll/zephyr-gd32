CONFIG_CONSOLE=y
CONFIG_RTC=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_GPIO=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=180000000
CONFIG_OSC_EXTERNAL=y

# Enable MPU
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# Enable native SDHC driver support (SD card slot uses SDHC0).
CONFIG_SDHC=y
CONFIG_SDHC_KINETIS=y
