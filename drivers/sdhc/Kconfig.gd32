config SDHC_GD32
	bool "GD32 SDIO SDHC driver"
	default y
	depends on DT_HAS_GD_GD32_SDHC_ENABLED
	select SDHC_SUPPORTS_NATIVE_MODE
	select USE_GD32_SDIO
	select USE_GD32_DMA
	select DMA
	select MEM_ATTR
	select PINCTRL
	help
	  Enables the GD32 SDIO-based SDHC driver (DMA-only data transfers).

if SDHC_GD32

config SDHC_BUFFER_ALIGNMENT
	default 4

config SDHC_GD32_BOUNCE_BUFFER_SIZE
	int "GD32 SDIO bounce buffer size"
	default 512
	help
	  Size in bytes of the static bounce buffer used when SDIO DMA needs
	  a DMA-capable buffer (DT_MEM_DMA) or when the provided buffer or
	  length is not word-aligned. If the transfer is larger than the
	  bounce buffer, the driver splits it into multiple transfers.
	  Set to 0 to disable bounce buffering and require DMA-safe buffers.

endif # SDHC_GD32
