config SDHC_GD32
	bool "GD32 SDIO SDHC driver"
	default y
	depends on DT_HAS_GD_GD32_SDHC_ENABLED
	select SDHC_SUPPORTS_NATIVE_MODE
	select USE_GD32_SDIO
	select USE_GD32_DMA
	select DMA
	select MEM_ATTR
	select PINCTRL
	help
	  Enables the GD32 SDIO-based SDHC driver (DMA-only data transfers).

if SDHC_GD32

config SDHC_BUFFER_ALIGNMENT
	default 4

config SD_BUFFER_SIZE
	int
	default 512

endif # SDHC_GD32
