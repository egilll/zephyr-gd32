#include <zephyr/dt-bindings/usb/audio.h>

/ {
	uac1_headphones: usb_audio1 {
		compatible = "zephyr,uac1";
		status = "okay";
		full-speed;
		high-speed;
		interrupt-endpoint;

		in_terminal: in_terminal {
			compatible = "zephyr,uac1-input-terminal";
			terminal-type = <USB_TERMINAL_STREAMING>;
			channels = <2>;
			channel-config = <0x0003>; /* Left Front (L) | Right Front (R) */
		};

		feature_unit: feature_unit {
			compatible = "zephyr,uac1-feature-unit";
			data-source = <&in_terminal>;
			controls = <0x0003>; /* Mute (D0) | Volume (D1) */
			channel-controls = <0x0003 0x0003>;
			/* -90 dB .. 0 dB, 1 dB step; values are in 1/256 dB. */
			volume-min = <(-90 * 256)>;
			volume-max = <0>;
			volume-res = <(1 * 256)>;
		};

		out_terminal: out_terminal {
			compatible = "zephyr,uac1-output-terminal";
			terminal-type = <OUTPUT_TERMINAL_HEADPHONES>;
			data-source = <&feature_unit>;
		};

		as_iso_out: out_interface {
			compatible = "zephyr,uac1-audio-streaming";
			linked-terminal = <&in_terminal>;
			sync-type = "asynchronous";
			feedback-refresh = <0>;
			sampling-frequencies = <48000>;
			subslot-size = <2>;
			bit-resolution = <16>;
		};
	};
};
